{
  "name": "minitor",
  "version": "0.1.0",
  "description": "Embedded Tor hidden service for ESP32 — Triple-Layer-Development/Minitor + jpbland1/wolfssl",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "build": {
    "srcFilter": [
      "+<minitor/src/*.c>",
      "+<minitor/src/models/*.c>",
      "+<minitor/src/structures/*.c>",
      "+<wolfssl/src/ssl.c>",
      "+<wolfssl/src/tls.c>",
      "+<wolfssl/src/keys.c>",
      "+<wolfssl/src/internal.c>",
      "+<wolfssl/src/wolfio.c>",
      "+<wolfssl/src/pk.c>",
      "+<wolfssl/src/bio.c>",
      "+<wolfssl/src/ssl_misc.c>",
      "+<wolfssl/wolfcrypt/src/*.c>",
      "+<compat/timegm.c>",
      "+<compat/nanosleep.c>",
      "+<compat/ed25519_sign_msg_custom.c>",
      "-<minitor/examples/>",
      "-<wolfssl/src/x509.c>",
      "-<wolfssl/src/x509_str.c>",
      "-<wolfssl/src/pkcs12.c>",
      "-<wolfssl/src/pkcs7.c>",
      "-<wolfssl/src/ocsp.c>",
      "-<wolfssl/src/crl.c>",
      "-<wolfssl/src/sniffer.c>"
    ],
    "includeDir": "src",
    "flags": [
      "-Ilib/minitor/src/compat",
      "-Ilib/minitor/src",
      "-Ilib/minitor/src/minitor/include",
      "-Ilib/minitor/src/minitor/h",
      "-Ilib/minitor/src/wolfssl",
      "-Ilib/minitor/src/wolfssl/wolfssl",
      "-DWOLFSSL_USER_SETTINGS",
      "-DFILESYSTEM_PREFIX='\"/sd/tor/\"'",
      "-DDEBUG_MINITOR",
      "-Wno-incompatible-pointer-types",
      "-Wno-implicit-function-declaration",
      "-Wno-int-conversion",
      "-Wno-return-type"
    ]
  }
}
